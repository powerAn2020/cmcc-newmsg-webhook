HOST=0.0.0.0
PORT=3000
CMCC_WS_URL=wss://5gvas01.cmicmaap.com/gtw-ai/openclaw/ws/msg
CMCC_WS_VERSION=2.0
CMCC_SEND_TIMEOUT_MS=10000
CMCC_UPLOAD_URL=https://5gvas01.cmicmaap.com/gtw-ai/openclaw/api
CMCC_UPLOAD_TIMEOUT_MS=120000
CMCC_DATABASE_PATH=./data/cmcc-webhook.sqlite
# Database type: sqlite (default), postgres, or mysql
DB_TYPE=sqlite
# Optional connection URL or discrete parameters for PostgreSQL / MySQL:
# DATABASE_URL=postgres://user:password@localhost:5432/cmcc_db
# DATABASE_URL=mysql://user:password@localhost:3306/cmcc_db
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=secret
# DB_NAME=cmcc_db
# DB_SSL=false
# Required: do not use a default password or encryption key in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
# Set true when TLS terminates at this service; leave false only for local HTTP development.
ADMIN_COOKIE_SECURE=false

# Brute-force prevention configurations
# Maximum failed attempts before locking the IP
ADMIN_LOGIN_FAIL_LIMIT=5
# Time window in minutes to observe login failures (default 15 minutes)
ADMIN_LOGIN_FAIL_WINDOW_MIN=15
# Duration of the IP ban/lock in minutes (default 30 minutes)
ADMIN_LOGIN_BAN_DURATION_MIN=30

# Access audit log settings
ACCESS_LOG_PATH=./logs/access.log
ACCESS_LOG_FORMAT=text
ACCESS_LOG_RETENTION_DAYS=7

# Security alert notifications
NOTIFY_ON_LOGIN=false
NOTIFY_ON_LOGIN_FAILED=false
NOTIFY_ON_AUTH_FAILED=false
NOTIFY_UPSTREAM_ID=0
NOTIFY_LOGIN_FAIL_THRESHOLD=3
NOTIFY_AUTH_FAIL_THRESHOLD=3
NOTIFY_AUTH_FAIL_WINDOW_MIN=1

# SMS bomb prevention and rate limiting
# Minimum interval in seconds between messages to the same phone number (default 60s)
RATE_LIMIT_PHONE_MIN_INTERVAL_SEC=60
# Max messages allowed to the same phone number within 1 hour (default 10)
RATE_LIMIT_PHONE_HOUR_MAX=10
# Max messages allowed to the same phone number within 24 hours (default 20)
RATE_LIMIT_PHONE_DAY_MAX=20
# Max requests allowed per client IP within 1 minute (default 30)
RATE_LIMIT_IP_MIN_MAX=30
# Duplicate content suppression window in seconds for the same target (default 300s, 0 to disable)
RATE_LIMIT_DUPLICATE_WINDOW_SEC=300
# Whether to send security alert notification when bomb/rate limit is triggered (default true)
NOTIFY_ON_RATE_LIMIT=true

